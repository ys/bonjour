{
  "name": "yannickschutz.com",
  "version": "2.0.0",
  "engines": {
    "node": "24.x"
  },
  "description": "https://yannickschutz.com",
  "scripts": {
    "prebuild": "mkdir -p resources/_gen node_modules/.cache/hugo_resources && cp -a node_modules/.cache/hugo_resources/. resources/_gen/ 2>/dev/null || true",
    "build": "hugo --gc --minify -b https://${BASE_URL:-$VERCEL_BRANCH_URL}",
    "postbuild": "rm -rf node_modules/.cache/hugo_resources && mkdir -p node_modules/.cache && cp -a resources/_gen node_modules/.cache/hugo_resources",
    "build-preview": "hugo --environment preview --minify -F -D -b https://${BASE_URL:-$VERCEL_BRANCH_URL}",
    "debug": "rm -rf public/* resources/_gen && hugo --templateMetrics --templateMetricsHints --printUnusedTemplates",
    "dev": "hugo serve --disableFastRender -p $PORT",
    "start": "hugo serve --disableFastRender --appendPort=false -b $(curl http://127.0.0.1:4040/api/tunnels | jq '.tunnels[0].public_url' -r)",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "author": "Yannick Schutz",
  "license": "MIT",
  "resolutions": {
    "re2": "1.24.0",
    "nan": "2.26.2",
    "difflib": "https://github.com/postlight/difflib.js.git#32e8e38c7fcd935241b9baab71bb432fd9b166ed",
    "browser-request": "https://github.com/postlight/browser-request.git#feat-add-headers-to-response"
  },
  "dependencies": {
    "@catppuccin/tailwindcss": "^1.0.0",
    "@postlight/mercury-parser": "^2.2.1",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.19",
    "stripe": "^8.145.0",
    "tailwindcss": "^4.2.2"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3"
  }
}
