{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
  xmlns:xhtml="http://www.w3.org/1999/xhtml"
  xmlns:image="http://www.google.com/schemas/sitemap-image/1.1">
  {{- $seen := dict -}}
  {{ range where .Pages "Type" "not in" .Site.Params.doNotIndex  }}
    {{- /* Skip pages canonicalised elsewhere, the 404 page, and URLs already listed */ -}}
    {{- if and .Permalink (not .Params.canonical) (ne .Kind "404") (ne .Path "/404") (not (index $seen .Permalink)) -}}
    {{- $seen = merge $seen (dict .Permalink true) -}}
  <url>
    <loc>{{ .Permalink }}</loc>{{ if not .Lastmod.IsZero }}
    <lastmod>{{ safeHTML ( .Lastmod.Format "2006-01-02T15:04:05-07:00" ) }}</lastmod>{{ end }}{{ with .Sitemap.ChangeFreq }}
    <changefreq>{{ . }}</changefreq>{{ end }}{{ if ge .Sitemap.Priority 0.0 }}
    <priority>{{ .Sitemap.Priority }}</priority>{{ end }}{{ if .IsTranslated }}{{ range .Translations }}
    <xhtml:link
                rel="alternate"
                hreflang="{{ .Language.Locale }}"
                href="{{ .Permalink }}"
                />{{ end }}
    <xhtml:link
                rel="alternate"
                hreflang="{{ .Language.Locale }}"
                href="{{ .Permalink }}"
                />{{ end }}
    {{- /* Photos of the page, at the size the zoom already publishes, for Google Images */ -}}
    {{- range .Resources.ByType "image" }}{{ if and (reflect.IsImageResourceProcessable .) (ne .Name "card") (not (in .Name ".poster.")) }}
    <image:image>
      <image:loc>{{ partialCached "zoomsrc.html" . .RelPermalink | absURL }}</image:loc>
    </image:image>{{ end }}{{ end }}
  </url>
    {{- end -}}
  {{ end }}
</urlset>
